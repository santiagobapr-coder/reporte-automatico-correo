# Copia este archivo como .env (o exporta las variables) y completa tus datos.
# Con Gmail: activa la verificación en dos pasos y crea una "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
MAIL_FROM=tu_correo@gmail.com
MAIL_TO=cliente1@ejemplo.com,cliente2@ejemplo.com
